<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>نقاط العظماء</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="style.css" />

  <style>
    /* إضافات بسيطة متوافقة مع التصميم الأصلي */
    .header-subtitle {
      font-size: 0.72rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .header-brand {
      display: flex;
      flex-direction: column;
    }

    .btn-danger-soft {
      color: #fca5a5;
      border-color: rgba(239, 68, 68, 0.35);
    }

    .btn-danger-soft:hover {
      background: rgba(239, 68, 68, 0.08);
    }

    .task-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 12px;
    }

    .task-editor-row {
      display: grid;
      grid-template-columns: 1fr 90px 42px;
      gap: 8px;
      align-items: center;
    }

    .task-editor-row .form-input {
      margin: 0;
    }

    .task-delete-btn {
      height: 42px;
      border-radius: 8px;
      border: 1px solid rgba(239, 68, 68, 0.35);
      background: rgba(239, 68, 68, 0.08);
      color: #fca5a5;
      cursor: pointer;
      font-size: 1rem;
    }

    .task-delete-btn:hover {
      background: rgba(239, 68, 68, 0.15);
    }

    .tasks-hint {
      color: var(--muted);
      font-size: 0.8rem;
      line-height: 1.8;
      margin-bottom: 12px;
    }

    .reset-warning {
      background: rgba(239, 68, 68, 0.07);
      border: 1px solid rgba(239, 68, 68, 0.2);
      border-radius: 10px;
      padding: 12px;
      color: #fca5a5;
      font-size: 0.82rem;
      line-height: 1.8;
      margin: 14px 0;
    }

    .task-empty {
      padding: 20px;
      text-align: center;
      color: var(--muted);
      border: 1px dashed #293548;
      border-radius: 10px;
    }

    @media (max-width: 600px) {
      .task-editor-row {
        grid-template-columns: 1fr 72px 40px;
      }

      .header-subtitle {
        display: none;
      }
    }
  </style>
</head>

<body>

  <!-- LOGIN -->
  <div id="login-screen">
    <div class="login-box">
      <div class="login-logo">🏆</div>
      <h2>لوحة النقاط</h2>
      <p>أدخل كلمة المرور للوصول</p>

      <input
        type="password"
        id="pw-input"
        class="login-input"
        placeholder="••••••••"
        onkeydown="if (event.key === 'Enter') doLogin();"
      />

      <button class="login-btn" onclick="doLogin()">
        دخول
      </button>

      <div class="login-error" id="login-err">
        ❌ كلمة المرور غير صحيحة
      </div>
    </div>
  </div>


  <!-- DASHBOARD -->
  <div id="dashboard">

    <header>

      <div class="header-brand">
        <div class="header-title">
          🏆 لوحة النقاط
        </div>

        <div class="header-subtitle">
          فريق العظماء
        </div>
      </div>


      <div class="header-actions">

        <button
          class="btn btn-primary"
          onclick="openAddModal()"
        >
          ➕ إضافة عضو
        </button>


        <button
          class="btn btn-outline"
          onclick="openTasksModal()"
        >
          ⚙️ إدارة المهام
        </button>


        <button
          class="btn btn-outline"
          onclick="openReportModal()"
        >
          🖨️ تقرير Discord
        </button>


        <button
          class="btn btn-outline btn-danger-soft"
          onclick="openResetModal()"
        >
          ♻️ إعادة ضبط
        </button>


        <input
          type="file"
          id="import-file"
          accept=".json"
          style="display:none"
          onchange="handleImport(event)"
        />


        <button
          class="btn btn-outline"
          onclick="logout()"
          style="padding:9px 12px"
          title="تسجيل الخروج"
        >
          🚪
        </button>

      </div>

    </header>


    <main>

      <!-- STATS -->

      <div class="stats-grid">

        <div class="stat-card blue">
          <div class="stat-icon">👥</div>
          <div class="stat-value" id="stat-total">0</div>
          <div class="stat-label">إجمالي الأعضاء</div>
        </div>


        <div class="stat-card gold">
          <div class="stat-icon">⭐</div>
          <div class="stat-value" id="stat-points">0</div>
          <div class="stat-label">مجموع النقاط</div>
        </div>


        <div class="stat-card purple">
          <div class="stat-icon">🥇</div>
          <div class="stat-value" id="stat-top">—</div>
          <div class="stat-label">الأعلى نقاطاً</div>
        </div>


        <div class="stat-card green">
          <div class="stat-icon">📊</div>
          <div class="stat-value" id="stat-avg">0</div>
          <div class="stat-label">متوسط النقاط</div>
        </div>

      </div>


      <!-- CONTROLS -->

      <div class="controls">

        <input
          type="text"
          class="search-input"
          placeholder="🔍 بحث بالاسم..."
          oninput="renderTable()"
          id="search"
        />


        <select
          class="search-input"
          style="max-width:160px"
          onchange="renderTable()"
          id="filter-rank"
        >
          <option value="">كل الرتب</option>
          <option value="3">رتبة 3</option>
          <option value="4">رتبة 4</option>
          <option value="5">رتبة 5</option>
          <option value="6">رتبة 6</option>
        </select>


        <select
          class="search-input"
          style="max-width:160px"
          onchange="renderTable()"
          id="sort-by"
        >
          <option value="name">ترتيب: الاسم</option>
          <option value="points-desc">الأعلى نقاطاً</option>
          <option value="points-asc">الأقل نقاطاً</option>
          <option value="rank">الرتبة</option>
        </select>

      </div>


      <!-- TABLE -->

      <div class="table-wrap">

        <table>

          <thead>
            <tr>
              <th>#</th>
              <th>الاسم</th>
              <th>الرتبة</th>
              <th>النقاط</th>
              <th>الإجراءات</th>
            </tr>
          </thead>

          <tbody id="table-body"></tbody>

        </table>


        <div
          id="empty-state"
          class="empty-state"
          style="display:none"
        >

          <div class="empty-icon">
            📭
          </div>

          <div>
            لا يوجد أعضاء بعد
          </div>

        </div>

      </div>

    </main>

  </div>


  <!-- ADD / EDIT MEMBER -->

  <div
    class="modal-bg"
    id="member-modal"
  >

    <div class="modal">

      <h3 id="modal-title">
        ➕ إضافة عضو جديد
      </h3>


      <div class="form-group">

        <label class="form-label">
          الاسم
        </label>

        <input
          type="text"
          class="form-input"
          id="m-name"
          placeholder="اسم العضو"
        />

      </div>


      <div class="form-group">

        <label class="form-label">
          الرتبة
        </label>

        <select
          class="form-input"
          id="m-rank"
        >
          <option value="3">رتبة 3</option>
          <option value="4">رتبة 4</option>
          <option value="5">رتبة 5</option>
          <option value="6">رتبة 6</option>
        </select>

      </div>


      <div class="form-group">

        <label class="form-label">
          النقاط الابتدائية
        </label>

        <input
          type="number"
          class="form-input"
          id="m-points"
          placeholder="0"
          min="0"
          value="0"
        />

      </div>


      <div class="form-group">

        <label class="form-label">
          الجنس
        </label>

        <select
          class="form-input"
          id="m-gender"
        >
          <option value="male">ذكر</option>
          <option value="female">أنثى</option>
        </select>

      </div>


      <div class="modal-footer">

        <button
          class="btn btn-outline"
          onclick="closeModal('member-modal')"
        >
          إلغاء
        </button>

        <button
          class="btn btn-primary"
          onclick="saveMember()"
        >
          حفظ
        </button>

      </div>

    </div>

  </div>


  <!-- ADD POINTS -->

  <div
    class="modal-bg"
    id="points-modal"
  >

    <div class="modal">

      <h3 id="pts-modal-title">
        ⭐ إضافة نقاط
      </h3>


      <div class="points-actions">

        <h4 id="pts-actions-label">
          مهام فريق العظماء
        </h4>

        <div
          class="action-list"
          id="action-list"
        ></div>

      </div>


      <div class="form-group">

        <label class="form-label">
          أو أدخل نقاط مخصصة
        </label>

        <input
          type="number"
          class="form-input"
          id="custom-pts"
          placeholder="0"
          min="0"
        />

      </div>


      <div class="form-group">

        <label class="form-label">
          ملاحظة
        </label>

        <input
          type="text"
          class="form-input"
          id="pts-note"
          placeholder="سبب الإضافة..."
        />

      </div>


      <div class="form-group">

        <label class="form-label">
          سجل النقاط
        </label>

        <div
          class="history-log"
          id="pts-history"
        ></div>

      </div>


      <div class="modal-footer">

        <button
          class="btn btn-outline"
          onclick="closeModal('points-modal')"
        >
          إغلاق
        </button>

        <button
          class="btn btn-primary"
          onclick="addCustomPoints()"
        >
          إضافة
        </button>

      </div>

    </div>

  </div>


  <!-- TASK MANAGER -->

  <div
    class="modal-bg"
    id="tasks-modal"
  >

    <div
      class="modal"
      style="max-width:650px"
    >

      <h3>
        ⚙️ إدارة مهام النقاط
      </h3>


      <div class="tasks-hint">

        المهام موحدة لجميع أعضاء الفريق مهما كانت الرتبة.

        <br />

        يمكنك تعديل اسم أي مهمة أو عدد نقاطها،
        وإضافة مهام جديدة أو حذفها.

      </div>


      <div
        class="task-list"
        id="tasks-editor"
      ></div>


      <button
        class="btn btn-outline"
        onclick="addTaskRow()"
        style="margin-top:14px"
      >
        ➕ إضافة مهمة جديدة
      </button>


      <div class="modal-footer">

        <button
          class="btn btn-outline"
          onclick="closeModal('tasks-modal')"
        >
          إلغاء
        </button>

        <button
          class="btn btn-primary"
          onclick="saveTasks()"
        >
          💾 حفظ التعديلات
        </button>

      </div>

    </div>

  </div>


  <!-- DELETE CONFIRM -->

  <div
    class="modal-bg"
    id="delete-modal"
  >

    <div class="modal confirm-modal">

      <div class="confirm-icon">
        🗑️
      </div>

      <h3>
        حذف العضو
      </h3>

      <p>
        هل أنت متأكد من حذف
      </p>

      <span
        class="confirm-name"
        id="delete-name"
      >
        —
      </span>

      <p
        style="
          font-size:.8rem;
          color:var(--muted);
          margin-top:-16px;
        "
      >
        لا يمكن التراجع عن هذا الإجراء
      </p>


      <div class="confirm-btns">

        <button
          class="btn btn-outline"
          onclick="closeModal('delete-modal')"
        >
          إلغاء
        </button>

        <button
          class="btn btn-confirm-del"
          onclick="confirmDelete()"
        >
          🗑️ حذف
        </button>

      </div>

    </div>

  </div>


  <!-- RESET POINTS -->

  <div
    class="modal-bg"
    id="reset-modal"
  >

    <div class="modal confirm-modal">

      <div class="confirm-icon">
        ♻️
      </div>

      <h3>
        إعادة ضبط النقاط
      </h3>


      <p>
        هل تريدين بدء أسبوع جديد؟
      </p>


      <div class="reset-warning">

        سيتم تصفير نقاط جميع الأعضاء ومسح سجل النقاط الحالي.

        <br />

        الأعضاء والرتب لن يتم حذفهم.

      </div>


      <div class="confirm-btns">

        <button
          class="btn btn-outline"
          onclick="closeModal('reset-modal')"
        >
          إلغاء
        </button>

        <button
          class="btn btn-confirm-del"
          onclick="resetAllPoints()"
        >
          ♻️ تصفير النقاط
        </button>

      </div>

    </div>

  </div>


  <!-- DISCORD REPORT -->

  <div
    class="modal-bg"
    id="report-modal"
  >

    <div
      class="modal"
      style="max-width:640px"
    >

      <h3>
        🖨️ تقرير Discord
      </h3>


      <div class="form-group">

        <label class="form-label">
          ترتيب حسب
        </label>

        <select
          class="form-input"
          id="report-sort"
          onchange="generateReport()"
        >

          <option value="points-desc">
            الأعلى نقاطاً أولاً
          </option>

          <option value="points-asc">
            الأقل نقاطاً أولاً
          </option>

          <option value="name">
            الاسم
          </option>

          <option value="rank">
            الرتبة
          </option>

        </select>

      </div>


      <div class="form-group">

        <label class="form-label">
          النص الجاهز للنسخ إلى Discord
        </label>

        <textarea
          id="report-text"
          readonly
          style="
            width:100%;
            height:430px;
            direction:ltr;
            text-align:left;
            font-family:monospace;
            font-size:.8rem;
            background:#0a0f1e;
            color:#e2e8f0;
            border:1px solid #1f2937;
            border-radius:8px;
            padding:10px;
            resize:vertical;
          "
        ></textarea>

      </div>


      <div class="modal-footer">

        <button
          class="btn btn-outline"
          onclick="closeModal('report-modal')"
        >
          إغلاق
        </button>

        <button
          class="btn btn-primary"
          onclick="copyReport()"
        >
          📋 نسخ النص
        </button>

      </div>

    </div>

  </div>


  <!-- TOAST -->

  <div id="toast"></div>


<script>

const PASSWORD = "Noura";

const STORAGE_KEY = "dashboard_data";

const TASKS_KEY = "greats_points_tasks";


/* ==============================
   DISCORD EMOJIS
============================== */

const DISCORD_STAR =
  "<a:star:1336484075275288697>";

const DISCORD_STAR_PINK =
  "<a:util_star_pink:1353652705842823168>";

const DISCORD_PINK =
  "<a:pink:1348900341978107924>";

const DISCORD_LOADER_MALE =
  "<a:ss_5:1439984627946356756>";

const DISCORD_LINE =
  "<a:line_rgb:1425509094013538347>";


/* ==============================
   DEFAULT TASKS
============================== */

const DEFAULT_TASKS = [

  {
    label: "محاضرة إرشادية",
    pts: 7
  },

  {
    label: "دورية إنعاش",
    pts: 4
  },

  {
    label: "فعالية تحالف",
    pts: 4
  },

  {
    label: "فعالية أدمن",
    pts: 4
  },

  {
    label: "تنظيم مستشفى",
    pts: 3
  }

];


let members = [];

let tasks = [];

let editingId = null;

let pointsTargetId = null;

let deleteTargetId = null;


/* ==============================
   LOGIN
============================== */

function doLogin() {

  const pw =
    document.getElementById("pw-input").value;

  if (pw === PASSWORD) {

    document.getElementById(
      "login-screen"
    ).style.display = "none";

    document.getElementById(
      "dashboard"
    ).style.display = "block";

    loadData();

  } else {

    document.getElementById(
      "login-err"
    ).style.display = "block";

    document.getElementById(
      "pw-input"
    ).value = "";

    document.getElementById(
      "pw-input"
    ).focus();

  }

}


function logout() {

  document.getElementById(
    "login-screen"
  ).style.display = "flex";

  document.getElementById(
    "dashboard"
  ).style.display = "none";

  document.getElementById(
    "pw-input"
  ).value = "";

  document.getElementById(
    "login-err"
  ).style.display = "none";

}


/* ==============================
   STORAGE
============================== */

function loadData() {

  const raw =
    localStorage.getItem(STORAGE_KEY);

  if (raw) {

    try {

      members = JSON.parse(raw);

    } catch {

      members = [];

    }

  }


  const rawTasks =
    localStorage.getItem(TASKS_KEY);

  if (rawTasks) {

    try {

      tasks = JSON.parse(rawTasks);

    } catch {

      tasks =
        DEFAULT_TASKS.map(
          task => ({ ...task })
        );

    }

  } else {

    tasks =
      DEFAULT_TASKS.map(
        task => ({ ...task })
      );

  }


  renderTable();

  updateStats();

}


function saveData() {

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(members)
  );

}


function saveTasksData() {

  localStorage.setItem(
    TASKS_KEY,
    JSON.stringify(tasks)
  );

}


function generateId() {

  return (
    Date.now().toString(36) +
    Math.random()
      .toString(36)
      .substr(2)
  );

}


/* ==============================
   STATS
============================== */

function updateStats() {

  const total =
    members.length;


  const totalPts =
    members.reduce(
      (sum, member) =>
        sum + (member.points || 0),
      0
    );


  const avg =
    total
      ? Math.round(totalPts / total)
      : 0;


  const top =
    total
      ? members.reduce(
          (a, b) =>
            b.points > a.points
              ? b
              : a
        ).name
      : "—";


  document.getElementById(
    "stat-total"
  ).textContent = total;


  document.getElementById(
    "stat-points"
  ).textContent = totalPts;


  document.getElementById(
    "stat-avg"
  ).textContent = avg;


  document.getElementById(
    "stat-top"
  ).textContent =
    total
      ? top.split(" ")[0]
      : "—";

}


/* ==============================
   TABLE
============================== */

function renderTable() {

  const search =
    document
      .getElementById("search")
      .value
      .toLowerCase();


  const filterRank =
    document.getElementById(
      "filter-rank"
    ).value;


  const sortBy =
    document.getElementById(
      "sort-by"
    ).value;


  let filtered =
    members.filter(member => {

      return (

        member.name
          .toLowerCase()
          .includes(search)

        &&

        (
          filterRank
            ? String(member.rank)
                === filterRank
            : true
        )

      );

    });


  if (
    sortBy === "points-desc"
  ) {

    filtered.sort(
      (a, b) =>
        b.points - a.points
    );

  }

  else if (
    sortBy === "points-asc"
  ) {

    filtered.sort(
      (a, b) =>
        a.points - b.points
    );

  }

  else if (
    sortBy === "rank"
  ) {

    filtered.sort(
      (a, b) =>
        a.rank - b.rank
    );

  }

  else {

    filtered.sort(
      (a, b) =>
        a.name.localeCompare(
          b.name,
          "ar"
        )
    );

  }


  const tbody =
    document.getElementById(
      "table-body"
    );


  const empty =
    document.getElementById(
      "empty-state"
    );


  if (
    filtered.length === 0
  ) {

    tbody.innerHTML = "";

    empty.style.display =
      "block";

  }

  else {

    empty.style.display =
      "none";


    tbody.innerHTML =
      filtered
        .map(
          (member, index) => `

<tr>

<td style="color:var(--muted)">
${index + 1}
</td>

<td>
<strong>
${escHtml(member.name)}
</strong>
</td>

<td>
<span class="rank-badge rank-${member.rank}">
${member.rank}
</span>
</td>

<td>
<span class="points-badge">
${member.points} نقطة
</span>
</td>

<td>

<div class="action-btns">

<button
class="btn-icon btn-add"
title="إضافة نقاط"
onclick="openPointsModal('${member.id}')"
>
⭐
</button>

<button
class="btn-icon btn-edit"
title="تعديل"
onclick="openEditModal('${member.id}')"
>
✏️
</button>

<button
class="btn-icon btn-del"
title="حذف"
onclick="deleteMember('${member.id}')"
>
🗑️
</button>

</div>

</td>

</tr>

`
        )
        .join("");

  }


  updateStats();

}


function escHtml(value) {

  return String(value)

    .replace(
      /&/g,
      "&amp;"
    )

    .replace(
      /</g,
      "&lt;"
    )

    .replace(
      />/g,
      "&gt;"
    )

    .replace(
      /"/g,
      "&quot;"
    );

}


/* ==============================
   MEMBERS
============================== */

function openAddModal() {

  editingId = null;


  document.getElementById(
    "modal-title"
  ).textContent =
    "➕ إضافة عضو جديد";


  document.getElementById(
    "m-name"
  ).value = "";


  document.getElementById(
    "m-rank"
  ).value = "3";


  document.getElementById(
    "m-points"
  ).value = "0";


  document.getElementById(
    "m-gender"
  ).value = "male";


  openModal(
    "member-modal"
  );

}


function openEditModal(id) {

  const member =
    members.find(
      item =>
        item.id === id
    );


  if (!member)
    return;


  editingId = id;


  document.getElementById(
    "modal-title"
  ).textContent =
    "✏️ تعديل العضو";


  document.getElementById(
    "m-name"
  ).value =
    member.name;


  document.getElementById(
    "m-rank"
  ).value =
    member.rank;


  document.getElementById(
    "m-points"
  ).value =
    member.points;


  document.getElementById(
    "m-gender"
  ).value =
    member.gender === "female"
      ? "female"
      : "male";


  openModal(
    "member-modal"
  );

}


function saveMember() {

  const name =
    document
      .getElementById("m-name")
      .value
      .trim();


  const rank =
    parseInt(
      document.getElementById(
        "m-rank"
      ).value
    );


  const points =
    parseInt(
      document.getElementById(
        "m-points"
      ).value
    ) || 0;


  const gender =
    document.getElementById(
      "m-gender"
    ).value;


  if (!name) {

    showToast(
      "أدخل اسم العضو",
      "error"
    );

    return;

  }


  if (editingId) {

    const member =
      members.find(
        item =>
          item.id === editingId
      );


    member.name =
      name;

    member.rank =
      rank;

    member.points =
      points;

    member.gender =
      gender;


    showToast(
      "تم التعديل بنجاح ✅",
      "success"
    );

  }

  else {

    members.push({

      id:
        generateId(),

      name,

      rank,

      points,

      gender,

      history: []

    });


    showToast(
      "تمت الإضافة بنجاح ✅",
      "success"
    );

  }


  saveData();

  renderTable();

  closeModal(
    "member-modal"
  );

}


/* ==============================
   DELETE MEMBER
============================== */

function deleteMember(id) {

  const member =
    members.find(
      item =>
        item.id === id
    );


  if (!member)
    return;


  deleteTargetId =
    id;


  document.getElementById(
    "delete-name"
  ).textContent =
    member.name;


  openModal(
    "delete-modal"
  );

}


function confirmDelete() {

  members =
    members.filter(
      member =>
        member.id !==
        deleteTargetId
    );


  deleteTargetId =
    null;


  saveData();

  renderTable();


  closeModal(
    "delete-modal"
  );


  showToast(
    "تم حذف العضو 🗑️",
    "error"
  );

}


/* ==============================
   POINTS
============================== */

function openPointsModal(id) {

  const member =
    members.find(
      item =>
        item.id === id
    );


  if (!member)
    return;


  pointsTargetId =
    id;


  document.getElementById(
    "pts-modal-title"
  ).textContent =
    `⭐ إضافة نقاط — ${member.name}`;


  document.getElementById(
    "pts-actions-label"
  ).textContent =
    "✨ مهام فريق العظماء";


  const actionList =
    document.getElementById(
      "action-list"
    );


  if (
    tasks.length === 0
  ) {

    actionList.innerHTML =
      `
      <div class="task-empty">
      لا توجد مهام حالياً
      </div>
      `;

  }

  else {

    actionList.innerHTML =
      tasks
        .map(
          (task, index) => `

<div
class="action-item"
onclick="quickAddTask(${index})"
>

<span>
${escHtml(task.label)}
</span>

<span class="action-pts">
+${task.pts}
</span>

</div>

`
        )
        .join("");

  }


  document.getElementById(
    "custom-pts"
  ).value = "";


  document.getElementById(
    "pts-note"
  ).value = "";


  renderHistory(
    member
  );


  openModal(
    "points-modal"
  );

}


function quickAddTask(index) {

  const task =
    tasks[index];


  if (!task)
    return;


  addPoints(
    task.pts,
    task.label
  );

}


function addCustomPoints() {

  const points =
    parseInt(
      document.getElementById(
        "custom-pts"
      ).value
    ) || 0;


  const note =
    document
      .getElementById(
        "pts-note"
      )
      .value
      .trim()

    ||

    "نقاط مخصصة";


  if (
    points <= 0
  ) {

    showToast(
      "أدخل عدد نقاط صحيح",
      "error"
    );

    return;

  }


  addPoints(
    points,
    note
  );


  document.getElementById(
    "custom-pts"
  ).value = "";


  document.getElementById(
    "pts-note"
  ).value = "";

}


function addPoints(
  points,
  label
) {

  const member =
    members.find(
      item =>
        item.id ===
        pointsTargetId
    );


  if (!member)
    return;


  member.points +=
    points;


  if (!member.history)
    member.history = [];


  member.history.unshift({

    label,

    pts:
      points,

    date:
      today()

  });


  if (
    member.history.length > 50
  ) {

    member.history =
      member.history.slice(
        0,
        50
      );

  }


  saveData();

  renderTable();

  renderHistory(
    member
  );


  showToast(
    `+${points} نقطة — ${label}`,
    "success"
  );

}


function renderHistory(
  member
) {

  const element =
    document.getElementById(
      "pts-history"
    );


  if (
    !member.history
    ||
    member.history.length === 0
  ) {

    element.innerHTML =
      `
      <div
      style="
      color:var(--muted);
      font-size:.82rem;
      padding:8px
      "
      >
      لا يوجد سجل بعد
      </div>
      `;

    return;

  }


  element.innerHTML =
    member.history
      .map(
        history => `

<div class="history-entry">

<span>
${escHtml(history.label)}
</span>

<span class="history-pts">
+${history.pts}
</span>

<span class="history-date">
${history.date}
</span>

</div>

`
      )
      .join("");

}


/* ==============================
   TASK MANAGER
============================== */

function openTasksModal() {

  renderTasksEditor();

  openModal(
    "tasks-modal"
  );

}


function renderTasksEditor() {

  const editor =
    document.getElementById(
      "tasks-editor"
    );


  if (
    tasks.length === 0
  ) {

    editor.innerHTML =
      `
      <div class="task-empty">
      لا توجد مهام.
      اضغطي "إضافة مهمة جديدة".
      </div>
      `;

    return;

  }


  editor.innerHTML =
    tasks
      .map(
        (task, index) => `

<div
class="task-editor-row"
data-index="${index}"
>

<input
type="text"
class="form-input task-name-input"
value="${escHtml(task.label)}"
placeholder="اسم المهمة"
/>

<input
type="number"
class="form-input task-points-input"
value="${task.pts}"
min="1"
placeholder="النقاط"
/>

<button
class="task-delete-btn"
onclick="removeTask(${index})"
title="حذف المهمة"
>
🗑️
</button>

</div>

`
      )
      .join("");

}


function syncTasksFromEditor() {

  const rows =
    document.querySelectorAll(
      "#tasks-editor .task-editor-row"
    );


  if (
    rows.length === 0
  ) {

    return [];

  }


  return Array
    .from(rows)
    .map(
      row => {

        const label =
          row
            .querySelector(
              ".task-name-input"
            )
            .value
            .trim();


        const pts =
          parseInt(
            row
              .querySelector(
                ".task-points-input"
              )
              .value
          ) || 0;


        return {
          label,
          pts
        };

      }
    );

}


function addTaskRow() {

  const current =
    syncTasksFromEditor();


  tasks =
    current.filter(
      task =>
        task.label
        ||
        task.pts
    );


  tasks.push({

    label: "",

    pts: 1

  });


  renderTasksEditor();


  const inputs =
    document.querySelectorAll(
      ".task-name-input"
    );


  if (
    inputs.length
  ) {

    inputs[
      inputs.length - 1
    ].focus();

  }

}


function removeTask(index) {

  const current =
    syncTasksFromEditor();


  current.splice(
    index,
    1
  );


  tasks =
    current;


  renderTasksEditor();

}


function saveTasks() {

  const updated =
    syncTasksFromEditor();


  const valid =
    updated.filter(
      task =>
        task.label
        &&
        task.pts > 0
    );


  if (
    valid.length === 0
  ) {

    showToast(
      "يجب وجود مهمة واحدة على الأقل",
      "error"
    );

    return;

  }


  tasks =
    valid;


  saveTasksData();


  closeModal(
    "tasks-modal"
  );


  showToast(
    "تم حفظ المهام والنقاط ✅",
    "success"
  );

}


/* ==============================
   RESET
============================== */

function openResetModal() {

  if (
    members.length === 0
  ) {

    showToast(
      "لا يوجد أعضاء حالياً",
