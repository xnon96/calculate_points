}


/* ==============================
   IMPORT
============================== */

function importJSON() {

  document.getElementById(
    "import-file"
  ).click();

}


function handleImport(event) {

  const file =
    event.target.files[0];


  if (!file)
    return;


  const reader =
    new FileReader();


  reader.onload =
    eventReader => {

      try {

        const data =
          JSON.parse(
            eventReader.target.result
          );


        if (
          Array.isArray(data)
        ) {

          members =
            data;


          saveData();

          renderTable();


          showToast(
            `تم استيراد ${data.length} عضو ✅`,
            "success"
          );

        }

        else {

          throw new Error();

        }

      }

      catch {

        showToast(
          "ملف غير صالح ❌",
          "error"
        );

      }

    };


  reader.readAsText(
    file
  );


  event.target.value =
    "";

}


/* ==============================
   DISCORD REPORT
============================== */

function openReportModal() {

  if (
    members.length === 0
  ) {

    showToast(
      "لا يوجد أعضاء لإنشاء التقرير",
      "error"
    );

    return;

  }


  document.getElementById(
    "report-sort"
  ).value =
    "points-desc";


  generateReport();


  openModal(
    "report-modal"
  );

}


function getReportDate() {

  const date =
    new Date();


  const day =
    String(
      date.getDate()
    ).padStart(
      2,
      "0"
    );


  const month =
    String(
      date.getMonth() + 1
    ).padStart(
      2,
      "0"
    );


  const year =
    date.getFullYear();


  return (
    `${day} / ${month} / ${year}`
  );

}


function generateReport() {

  const sortBy =
    document.getElementById(
      "report-sort"
    ).value;


  let list =
    [...members];


  if (
    sortBy === "points-desc"
  ) {

    list.sort(
      (a, b) =>
        b.points - a.points
    );

  }

  else if (
    sortBy === "points-asc"
  ) {

    list.sort(
      (a, b) =>
        a.points - b.points
    );

  }

  else if (
    sortBy === "rank"
  ) {

    list.sort(
      (a, b) =>
        a.rank - b.rank
    );

  }

  else {

    list.sort(
      (a, b) =>
        a.name.localeCompare(
          b.name,
          "ar"
        )
    );

  }


  const lineRow =
    Array(5)
      .fill(
        DISCORD_LINE
      )
      .join(" ");


  const blocks =
    list.map(
      member => {

        const starEmoji =

          member.gender ===
          "female"

            ? DISCORD_STAR_PINK

            : DISCORD_STAR;


        const pointsPart =

          member.points === 0

            ?

            (
              member.gender ===
              "female"

                ? DISCORD_PINK

                : DISCORD_LOADER_MALE
            )

            :

            member.points;


        return (

`### - ${member.name} (${pointsPart}) ${starEmoji}
${lineRow}`

        );

      }
    );


  const header =

`## <a:odin_gif_m_80:984046331603611678>  نقاط العظماء <a:odin_gif_m_80:984046331603611678> 

## 📅 التاريخ ┃ ${getReportDate()}`;


  const footer =

`-# 🤍 شكر خاص لأعضاء فريق العظماء
-# شكرًا لكل شخص كان حاضر ومتفاعل وقدم من وقته وجهده للفريق، نقاطكم تعكس تعبكم والتزامكم وعطاءكم.
-# فخورة فيكم وبكل اللي تقدمونه، واستمروا بنفس الحماس والتألق دائمًا 🤍🎙️
@everyone`;


  document.getElementById(
    "report-text"
  ).value =

`${header}

${blocks.join("\n")}

${footer}`;

}


/* ==============================
   COPY REPORT
============================== */

async function copyReport() {

  const text =
    document.getElementById(
      "report-text"
    ).value;


  try {

    await navigator
      .clipboard
      .writeText(text);


    showToast(
      "تم نسخ التقرير 📋",
      "success"
    );

  }

  catch {

    const textarea =
      document.getElementById(
        "report-text"
      );


    textarea.select();


    document.execCommand(
      "copy"
    );


    showToast(
      "تم نسخ التقرير 📋",
      "success"
    );

  }

}


/* ==============================
   MODALS
============================== */

function openModal(id) {

  document
    .getElementById(id)
    .classList
    .add("open");

}


function closeModal(id) {

  document
    .getElementById(id)
    .classList
    .remove("open");

}


document
  .querySelectorAll(
    ".modal-bg"
  )
  .forEach(
    background => {

      background
        .addEventListener(
          "click",
          event => {

            if (
              event.target ===
              background
            ) {

              background
                .classList
                .remove("open");

            }

          }
        );

    }
  );


/* ==============================
   TOAST
============================== */

function showToast(
  message,
  type = "success"
) {

  const toast =
    document.getElementById(
      "toast"
    );


  toast.textContent =
    message;


  toast.className =
    `show ${type}`;


  setTimeout(
    () => {

      toast.className =
        "";

    },
    2500
  );

}


/* ==============================
   DATE
============================== */

function today() {

  return new Date()
    .toLocaleDateString(
      "ar-SA",
      {

        year:
          "numeric",

        month:
          "2-digit",

        day:
          "2-digit"

      }
    );

}


/* ==============================
   ESC
============================== */

document
  .addEventListener(
    "keydown",
    event => {

      if (
        event.key ===
        "Escape"
      ) {

        document
          .querySelectorAll(
            ".modal-bg.open"
          )
          .forEach(
            modal =>
              modal
                .classList
                .remove("open")
          );

      }

    }
  );

</script>

